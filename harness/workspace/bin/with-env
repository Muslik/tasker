#!/usr/bin/env bash
# Load the external Tasker secret file without copying it into a harness snapshot.
set -euo pipefail

ENV_FILE="${TASKER_HARNESS_ENV_FILE:-}"
if [[ -n "$ENV_FILE" && -f "$ENV_FILE" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "${line// }" || "$line" == \#* || "$line" != *=* ]] && continue
    key="${line%%=*}"
    key="${key// }"
    [[ -n "${!key-}" ]] && continue
    value="${line#*=}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    value="${value%\"}"; value="${value#\"}"
    value="${value%\'}"; value="${value#\'}"
    export "$key=$value"
  done < "$ENV_FILE"
fi

if [[ $# -eq 0 ]]; then
  echo "usage: with-env <command> [args…]" >&2
  exit 2
fi

exec "$@"
