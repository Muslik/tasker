{
  "schemaVersion": 1,
  "id": "jira-lifecycle",
  "version": "1",
  "enabled": true,
  "description": "Admit explicitly selected Jira work before any repository or command mutation.",
  "appliesTo": {
    "taskOrigins": ["jira"]
  },
  "configuration": {
    "provider": "jira",
    "admission": {
      "accountName": "dzhabrail.markhiev@onetwotrip.com",
      "allowedIssueTypes": ["Bug", "Task", "Story", "Frontend Story", "Sub-task"],
      "deniedLabels": ["agent-disabled"],
      "statusPath": ["Backlog", "Open", "In Progress"]
    },
    "reviewReady": {
      "statusPath": ["In Progress", "Code Review"],
      "commentPrefix": "PR ready for review"
    }
  },
  "obligations": [
    {
      "id": "jira-admission-before-workspace-write",
      "kind": "path_sequence",
      "direction": "before",
      "trigger": { "kind": "effect", "reference": "workspace.write" },
      "ordered": [{ "kind": "step", "reference": "jira.start-work@1" }],
      "reason": "A Jira task must cross its accepted plan boundary and be admitted before repository mutation."
    },
    {
      "id": "jira-admission-before-command-run",
      "kind": "path_sequence",
      "direction": "before",
      "trigger": { "kind": "effect", "reference": "command.run" },
      "ordered": [{ "kind": "step", "reference": "jira.start-work@1" }],
      "reason": "A Jira task must be admitted before reproduction, verification, or another project command runs."
    },
    {
      "id": "jira-review-ready-before-code-review",
      "kind": "path_sequence",
      "direction": "before",
      "trigger": { "kind": "wait", "reference": "code_review@1" },
      "ordered": [
        { "kind": "step", "reference": "pr.prepare@1" },
        { "kind": "step", "reference": "ci.observe@1" },
        { "kind": "step", "reference": "jira.review-ready@1" }
      ],
      "reason": "A Jira task reaches human review only after its pull request, CI evidence, compact Jira comment, and review status are durable."
    }
  ]
}
