{
  "schemaVersion": 1,
  "id": "jira-lifecycle",
  "version": "1",
  "enabled": true,
  "description": "Admit explicitly selected Jira work before any repository or command mutation.",
  "appliesTo": {
    "taskOrigins": ["jira"]
  },
  "configuration": {
    "provider": "jira",
    "admission": {
      "accountName": "dzhabrail.markhiev@onetwotrip.com",
      "allowedIssueTypes": ["Bug", "Task", "Story", "Sub-task"],
      "deniedLabels": ["agent-disabled"],
      "statusPath": ["Backlog", "Open", "In Progress"]
    }
  },
  "obligations": [
    {
      "id": "jira-admission-before-workspace-write",
      "kind": "path_sequence",
      "direction": "before",
      "trigger": { "kind": "effect", "reference": "workspace.write" },
      "ordered": [
        { "kind": "gate", "reference": "plan.approved@1" },
        { "kind": "step", "reference": "jira.start-work@1" }
      ],
      "reason": "A Jira task must cross its accepted plan boundary and be admitted before repository mutation."
    },
    {
      "id": "jira-admission-before-command-run",
      "kind": "path_sequence",
      "direction": "before",
      "trigger": { "kind": "effect", "reference": "command.run" },
      "ordered": [
        { "kind": "gate", "reference": "plan.approved@1" },
        { "kind": "step", "reference": "jira.start-work@1" }
      ],
      "reason": "A Jira task must be admitted before reproduction, verification, or another project command runs."
    }
  ]
}
