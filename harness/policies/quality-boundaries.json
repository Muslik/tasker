{
  "schemaVersion": 1,
  "id": "quality-boundaries",
  "version": "1",
  "enabled": true,
  "description": "Require product mutation to pass semantic verification and independent review before delivery.",
  "configuration": {},
  "obligations": [
    {
      "id": "local-ready-before-delivery",
      "kind": "path_sequence",
      "direction": "after",
      "trigger": { "kind": "effect", "reference": "workspace.write" },
      "ordered": [
        { "kind": "step", "reference": "verify.acceptance@1" },
        { "kind": "step", "reference": "review.change@1" },
        { "kind": "step", "reference": "deliver.pull-request@1" }
      ],
      "reason": "A changed worktree must have accepted task evidence and independent review before remote delivery."
    },
    {
      "id": "delivery-feedback-is-frozen",
      "kind": "feedback_loops",
      "trigger": { "kind": "step", "reference": "deliver.pull-request@1" },
      "loops": [
        {
          "until": "delivery.accepted@1",
          "requiredSteps": [
            "implement.change@1",
            "verify.acceptance@1",
            "review.change@1",
            "deliver.pull-request@1"
          ]
        },
        {
          "until": "agent_review.accepted@1",
          "requiredSteps": ["implement.change@1", "verify.acceptance@1", "review.change@1"]
        },
        {
          "until": "verification.accepted@1",
          "requiredSteps": ["implement.change@1", "verify.acceptance@1"]
        }
      ],
      "reason": "Expected verification, review, and CI feedback must repeat the frozen workflow instead of creating a continuation."
    }
  ]
}
