{
  "schemaVersion": 1,
  "id": "quality-boundaries",
  "version": "1",
  "enabled": true,
  "description": "Require product mutation to pass semantic verification and independent review before delivery.",
  "configuration": {},
  "obligations": [
    {
      "id": "local-ready-before-delivery",
      "kind": "path_sequence",
      "direction": "after",
      "trigger": { "kind": "effect", "reference": "workspace.write" },
      "ordered": [
        { "kind": "step", "reference": "verify.acceptance@1" },
        { "kind": "step", "reference": "review.change@1" },
        { "kind": "step", "reference": "deliver.pull-request@1" }
      ],
      "reason": "A changed worktree must have accepted task evidence and independent review before remote delivery."
    }
  ]
}
