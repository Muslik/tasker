{
  "schemaVersion": 1,
  "id": "ai-assistance",
  "version": "1",
  "enabled": true,
  "description": "Every pull request carries auditable AI-assistance artifacts and a matching PR section.",
  "configuration": {
    "artifactsRoot": ".ai/workspace",
    "draftPath": ".tasker/pull-request/draft.json",
    "sectionPath": ".tasker/pull-request/ai-assistance.md",
    "defaultLevel": "Full Generation (>80%)",
    "author": "dzhabrail.markhiev",
    "tools": ["Codex"]
  },
  "agentSkills": [
    {
      "skill": "ai-assistance",
      "steps": [
        "code.implement@1",
        "implement.change@1",
        "code.repair@1",
        "ci.repair@1",
        "component.consume_published@1",
        "review.revise@1",
        "pr.describe@1"
      ]
    }
  ],
  "obligations": []
}
