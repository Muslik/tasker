{
  "schemaVersion": 2,
  "reference": "validate.build@1",
  "description": "Run the exact build validation command declared by project policy.",
  "stage": { "id": "verification", "label": "Validate" },
  "availableDuring": ["execution"],
  "inputContract": "verification_build_input",
  "outputContract": "process_output",
  "outputPredicates": {
    "discriminator": "exitCode",
    "cases": {
      "0": {
        "validation.passed@1": true,
        "validation.failed@1": false
      }
    },
    "defaultFacts": {
      "validation.passed@1": false,
      "validation.failed@1": true
    }
  },
  "executor": {
    "kind": "process",
    "executor": "validation.build@1"
  },
  "outcomes": ["completed", "needs_input", "blocked", "failed"],
  "completion": {
    "kind": "process_receipt",
    "acceptance": "any_exit"
  },
  "activityDelivery": "single_attempt",
  "allowedEffects": ["command.run"],
  "requiredCapabilities": ["command.run"],
  "resumeBoundary": "step",
  "idempotency": "probe",
  "waitKinds": [],
  "artifactContracts": ["validation-build-receipt"],
  "requiredArtifactContracts": [],
  "workflowChanges": [],
  "reconciliation": { "strategy": "probe" }
}
