{
  "schemaVersion": 2,
  "reference": "review.revise@1",
  "description": "Apply actionable human pull-request feedback with exact imported provenance.",
  "availableDuring": ["execution"],
  "stage": { "id": "review", "label": "Review" },
  "inputContract": "task_input",
  "outputContract": "agent_output",
  "executor": {
    "kind": "agent",
    "profile": "review",
    "prompt": "prompt.md",
    "skills": ["bitbucket"]
  },
  "outcomes": ["completed", "needs_input", "continuation_required", "blocked", "failed"],
  "completion": { "kind": "workspace_mutation" },
  "activityDelivery": "workspace_reconciled",
  "allowedEffects": ["workspace.write"],
  "requiredCapabilities": ["repository.read", "workspace.write"],
  "resumeBoundary": "step",
  "idempotency": "key",
  "waitKinds": [],
  "artifactContracts": ["review-revision-diff"],
  "requiredArtifactContracts": ["pull-request-review"],
  "workflowChanges": [
    "cross_repository_dependency",
    "external_process_required",
    "task_scope_changed",
    "verification_scope_changed"
  ],
  "reconciliation": { "strategy": "receipt" }
}
