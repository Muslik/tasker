{
  "schemaVersion": 2,
  "reference": "runtime.observe@1",
  "description": "Observe a material runtime claim before planning and preserve the result as reusable evidence.",
  "stage": { "id": "investigation", "label": "Investigate" },
  "availableDuring": ["bootstrap_investigation"],
  "inputContract": "runtime_observation_input",
  "outputContract": "runtime_observation_output",
  "executor": {
    "kind": "agent",
    "profile": "investigation",
    "strategyRole": "context",
    "prompt": "prompt.md",
    "skills": ["playwright-demo", "jenkins"]
  },
  "outcomes": ["completed", "needs_input", "continuation_required", "blocked", "failed"],
  "completion": {
    "kind": "structured_evidence",
    "source": "task_output",
    "requiredArtifactKinds": ["runtime-observation"]
  },
  "activityDelivery": "workspace_reconciled",
  "allowedEffects": ["command.run"],
  "requiredCapabilities": ["command.run", "repository.read"],
  "resumeBoundary": "step",
  "idempotency": "key",
  "waitKinds": [],
  "artifactContracts": ["runtime-observation"],
  "requiredArtifactContracts": [],
  "workflowChanges": [
    "cross_repository_dependency",
    "task_scope_changed",
    "verification_scope_changed"
  ],
  "reconciliation": { "strategy": "receipt" }
}
