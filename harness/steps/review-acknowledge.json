{
  "schemaVersion": 2,
  "reference": "review.acknowledge@1",
  "policy": "review-feedback",
  "description": "Reply to pull-request review threads after their requested changes are published and verified.",
  "stage": { "id": "review", "label": "Review" },
  "inputContract": "task_input",
  "outputContract": "integration_output",
  "executor": {
    "kind": "integration",
    "adapter": "bitbucket.review-reply@1"
  },
  "outcomes": ["completed", "needs_input", "blocked", "failed"],
  "completion": { "kind": "reconciled_effect" },
  "activityDelivery": "remote_reconciled",
  "allowedEffects": ["code-review.reply"],
  "requiredCapabilities": ["code-review.write"],
  "resumeBoundary": "step",
  "idempotency": "probe",
  "waitKinds": [],
  "artifactContracts": ["pull-request-review-acknowledgement"],
  "requiredArtifactContracts": ["pull-request", "pull-request-review"],
  "workflowChanges": [],
  "reconciliation": { "strategy": "probe" }
}
