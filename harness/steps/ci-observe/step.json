{
  "schemaVersion": 2,
  "reference": "ci.observe@1",
  "description": "Observe the exact Jenkins branch build and classify its terminal result.",
  "availableDuring": ["execution"],
  "stage": { "id": "delivery", "label": "Deliver" },
  "inputContract": "task_input",
  "outputContract": "ci_observation_output",
  "outputPredicates": {
    "discriminator": "status",
    "cases": {
      "passed": {
        "ci.passed@1": true,
        "ci.change_failure@1": false,
        "ci.flaky@1": false,
        "ci.infrastructure@1": false,
        "ci.unknown@1": false
      },
      "likely_caused_by_change": {
        "ci.passed@1": false,
        "ci.change_failure@1": true,
        "ci.flaky@1": false,
        "ci.infrastructure@1": false,
        "ci.unknown@1": false
      },
      "likely_flaky": {
        "ci.passed@1": false,
        "ci.change_failure@1": false,
        "ci.flaky@1": true,
        "ci.infrastructure@1": false,
        "ci.unknown@1": false
      },
      "infrastructure": {
        "ci.passed@1": false,
        "ci.change_failure@1": false,
        "ci.flaky@1": false,
        "ci.infrastructure@1": true,
        "ci.unknown@1": false
      },
      "unknown": {
        "ci.passed@1": false,
        "ci.change_failure@1": false,
        "ci.flaky@1": false,
        "ci.infrastructure@1": false,
        "ci.unknown@1": true
      }
    }
  },
  "executor": {
    "kind": "integration",
    "adapter": "jenkins.build@1"
  },
  "outcomes": ["completed", "needs_input", "blocked", "failed"],
  "completion": { "kind": "reconciled_effect" },
  "activityDelivery": "read_only",
  "allowedEffects": [],
  "requiredCapabilities": ["ci.read"],
  "resumeBoundary": "step",
  "idempotency": "probe",
  "waitKinds": [],
  "artifactContracts": ["ci-verdict"],
  "requiredArtifactContracts": ["pull-request"],
  "workflowChanges": [],
  "reconciliation": { "strategy": "probe" }
}
