{
  "schemaVersion": 1,
  "reference": "ci.observe@1",
  "description": "Observe the exact Jenkins branch build and classify its terminal result.",
  "retryBudget": 3,
  "inputContract": "task_input",
  "outputContract": "ci_observation_output",
