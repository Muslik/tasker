{
  "schemaVersion": 2,
  "version": "7",
  "repository": "onetwotrip/front-components",
  "repositoryKind": "frontend",
  "translations": { "kind": "none" },
  "ci": { "kind": "jenkins", "job": "front-components" },
  "git": {
    "baseBranch": "master",
    "branch": { "kind": "task_key_slug" },
    "commit": {
      "kind": "conventional_task_key",
      "allowedTypes": ["fix", "feat", "chore"],
      "requireScope": false
    }
  },
  "workspaceRuntime": {
    "bootstrap": ["pnpm install --frozen-lockfile", "pnpm exec playwright install chromium"],
    "services": []
  },
  "processCommands": {
    "validation.full@1": {
      "commands": [{ "command": "pnpm", "args": ["run", "test:unit:ci"] }]
    },
    "validation.build@1": {
      "commands": [
        {
          "command": "bash",
          "args": ["-lc", "CI=true WORKSPACE=\"${PWD##*/}\" pnpm run storybook:build"]
        }
      ]
    }
  }
}
