{
  "schemaVersion": 2,
  "version": "5",
  "repository": "onetwotrip/front-components",
  "repositoryKind": "frontend",
  "translations": { "kind": "none" },
  "ci": { "kind": "jenkins", "job": "front-components" },
  "git": {
    "baseBranch": "master",
    "branch": { "kind": "task_key_slug" },
    "commit": {
      "kind": "conventional_task_key",
      "allowedTypes": ["fix", "feat", "refactor", "test", "chore"],
      "requireScope": false
    }
  },
  "workspaceRuntime": {
    "bootstrap": ["pnpm install --frozen-lockfile", "pnpm exec playwright install chromium"],
    "services": []
  },
  "processCommands": {
    "validation.targeted@1": {
      "commands": [{ "command": "pnpm", "args": ["run", "lint-no-fix"] }]
    },
    "validation.full@1": {
      "commands": [{ "command": "pnpm", "args": ["run", "test:unit", "--runInBand"] }]
    },
    "validation.build@1": {
      "commands": [{ "command": "pnpm", "args": ["run", "storybook:build"] }]
    }
  }
}
