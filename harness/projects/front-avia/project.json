{
  "schemaVersion": 2,
  "version": "1",
  "repository": "onetwotrip/front-avia",
  "repositoryKind": "frontend",
  "translations": { "kind": "none" },
  "ci": { "kind": "jenkins", "job": "front-avia" },
  "workspaceRuntime": {
    "bootstrap": ["pnpm install --frozen-lockfile", "pnpm run dicts"],
    "services": [
      {
        "id": "front-avia-app",
        "command": "pnpm start",
        "aliases": ["local.onetwotrip.com", "test-partner.onetwotrip.com"],
        "environment": { "HOST": "0.0.0.0" },
        "readyCheck": "curl -k -I --fail --max-time 5 https://local.onetwotrip.com:3004 >/dev/null"
      }
    ]
  },
  "processCommands": {
    "validation.targeted@1": {
      "commands": [
        { "command": "pnpm", "args": ["run", "typecheck"] },
        { "command": "pnpm", "args": ["run", "lint:eslint"] },
        { "command": "pnpm", "args": ["run", "lint:stylelint"] },
        { "command": "pnpm", "args": ["run", "lint:circular"] }
      ]
    },
    "validation.full@1": {
      "commands": [{ "command": "pnpm", "args": ["run", "test:unit", "--", "--runInBand"] }]
    },
    "validation.build@1": {
      "commands": [{ "command": "pnpm", "args": ["run", "build"] }]
    }
  }
}
