{
  "schemaVersion": 2,
  "version": "6",
  "repository": "onetwotrip/front-avia",
  "repositoryKind": "frontend",
  "translations": { "kind": "none" },
  "ci": { "kind": "jenkins", "job": "front-avia" },
  "git": {
    "baseBranch": "master",
    "branch": { "kind": "task_key_slug" },
    "commit": { "kind": "task_key_subject" }
  },
  "workspaceRuntime": {
    "commandNetworkService": "front-avia-app",
    "bootstrap": [
      "pnpm install --frozen-lockfile",
      "pnpm exec playwright install chromium",
      "pnpm run dicts"
    ],
    "services": [
      {
        "id": "front-avia-app",
        "command": "pnpm start",
        "aliases": ["local.onetwotrip.com", "test-partner.onetwotrip.com"],
        "environment": { "HOST": "0.0.0.0" },
        "readyCheck": "curl -k -I --fail --max-time 5 https://local.onetwotrip.com:3004 >/dev/null"
      }
    ]
  },
  "processCommands": {
    "validation.targeted@1": {
      "commands": [
        { "command": "pnpm", "args": ["run", "typecheck"] },
        { "command": "pnpm", "args": ["run", "lint:eslint"] },
        { "command": "pnpm", "args": ["run", "lint:stylelint"] },
        { "command": "pnpm", "args": ["run", "lint:circular"] }
      ]
    },
    "validation.full@1": {
      "commands": [
        { "command": "pnpm", "args": ["run", "typecheck"] },
        { "command": "pnpm", "args": ["run", "lint:eslint"] },
        { "command": "pnpm", "args": ["run", "lint:stylelint"] },
        { "command": "pnpm", "args": ["run", "lint:circular"] },
        { "command": "pnpm", "args": ["run", "test:unit", "--runInBand"] },
        { "command": "pnpm", "args": ["run", "build"] }
      ]
    },
    "validation.build@1": {
      "commands": [{ "command": "pnpm", "args": ["run", "build"] }]
    }
  }
}
