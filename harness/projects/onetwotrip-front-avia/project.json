{
  "schemaVersion": 2,
  "version": "1",
  "repository": "onetwotrip/front-avia",
  "repositoryKind": "frontend",
  "translations": { "kind": "inline_json" },
  "ci": { "kind": "jenkins", "job": "front-avia" },
  "workspaceRuntime": {
    "bootstrap": ["pnpm install --frozen-lockfile", "pnpm run dicts"],
    "services": [
      {
        "id": "front-avia-app",
        "command": "pnpm start",
        "aliases": ["local.onetwotrip.com", "test-partner.onetwotrip.com"],
        "environment": {
          "HOST": "0.0.0.0"
        },
        "readyCheck": "curl -k -I --fail --max-time 5 https://local.onetwotrip.com:3004 >/dev/null"
      }
    ]
  },
  "processCommands": {
    "validation.targeted@1": "pnpm typecheck",
    "validation.full@1": "pnpm test --runInBand",
    "validation.build@1": "pnpm build",
    "validation.visual@1": "pnpm test:ui"
  },
  "workflowGuidance": "projects/onetwotrip-front-avia/workflow.md"
}
