{
  "schemaVersion": 2,
  "version": "4",
  "repository": "onetwotrip/front-core-packages",
  "repositoryKind": "frontend",
  "translations": { "kind": "none" },
  "ci": { "kind": "jenkins", "job": "front-core-packages" },
  "git": {
    "baseBranch": "master",
    "branch": { "kind": "task_key_slug" },
    "commit": {
      "kind": "conventional_task_key",
      "allowedTypes": ["fix", "feat", "refactor", "test", "chore"],
      "requireScope": false
    }
  },
  "workspaceRuntime": {
    "bootstrap": [
      "pnpm install --frozen-lockfile",
      "pnpm exec playwright install chromium",
      "mise use --global rust@1.97.1",
      "rustup target add wasm32-wasip1"
    ],
    "services": []
  },
  "processCommands": {
    "validation.targeted@1": {
      "commands": [
        { "command": "node", "args": ["type-check.mjs"] },
        { "command": "pnpm", "args": ["run", "linters"] }
      ]
    },
    "validation.full@1": {
      "commands": [{ "command": "pnpm", "args": ["run", "test:unit", "--runInBand"] }]
    },
    "validation.build@1": {
      "commands": [{ "command": "pnpm", "args": ["run", "build-packages"] }]
    }
  }
}
