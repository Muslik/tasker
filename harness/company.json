{
  "schemaVersion": 2,
  "id": "twiket-frontend",
  "version": "2",
  "availableCapabilities": [
    "ci.read",
    "command.run",
    "code-review.write",
    "git.write",
    "package.publish",
    "repository.read",
    "tracker.write",
    "workspace.write"
  ],
  "processCommands": {
    "component.dev-publish@1": {
      "commands": [{ "command": "pnpm", "args": ["component:publish-dev"] }],
      "timeoutMs": 2100000
    }
  },
  "workspaceRuntime": {
    "engine": "docker",
    "image": {
      "kind": "prebuilt",
      "reference": "tasker/workspace:local"
    },
    "workspaceMountPath": "/workspace",
    "environment": {
      "HOME": "/tasker/home",
      "MISE_DATA_DIR": "/tasker/cache/mise/data",
      "MISE_CACHE_DIR": "/tasker/cache/mise/cache",
      "MISE_CONFIG_DIR": "/tasker/home/.config/mise",
      "PNPM_HOME": "/tasker/home/.local/share/pnpm",
      "PATH": "/tasker/home/.local/share/pnpm:/tasker/home/.local/share/pnpm/bin:/tasker/cache/mise/data/shims:/usr/local/bin:/usr/bin:/bin",
      "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright"
    },
    "bootstrap": [],
    "cacheVolumes": [
      { "id": "home", "mountPath": "/tasker/home" },
      { "id": "node-modules", "mountPath": "/workspace/node_modules" },
      { "id": "pnpm-store", "mountPath": "/tasker/cache/pnpm-store" },
      { "id": "mise-cache", "mountPath": "/tasker/cache/mise" }
    ],
    "services": []
  },
  "systemPrompts": {
    "implementationPlanner": "prompts/implementation-planner.md",
    "implementationPlannerSkills": ["jira", "confluence", "loop"],
    "workflowAnalyzer": "prompts/workflow-analyzer.md"
  },
  "executionProfiles": {
    "workflow-analysis": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-terra",
      "effort": "medium",
      "timeoutMs": 600000,
      "serviceTier": "fast"
    },
    "planning-fast": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-terra",
      "effort": "medium",
      "timeoutMs": 600000,
      "serviceTier": "fast"
    },
    "planning-ralplan": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "timeoutMs": 1800000,
      "serviceTier": "fast"
    },
    "investigation": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "timeoutMs": 2100000,
      "serviceTier": "fast"
    },
    "implementation": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "timeoutMs": 2100000,
      "serviceTier": "fast"
    },
    "verification": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-terra",
      "effort": "medium",
      "timeoutMs": 1200000,
      "serviceTier": "fast"
    },
    "documentation": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-terra",
      "effort": "low",
      "timeoutMs": 600000,
      "serviceTier": "fast"
    },
    "review": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "timeoutMs": 1200000,
      "serviceTier": "fast"
    },
    "claude-ralplan": {
      "provider": "claude",
      "command": "claude",
      "model": "opus",
      "effort": "high",
      "timeoutMs": 1800000
    }
  },
  "executionProfileRouting": {
    "workflowAnalyzer": "workflow-analysis",
    "implementationPlanner": {
      "fast": "planning-fast",
      "ralplan": "planning-ralplan"
    }
  },
  "globalPackageRules": [
    {
      "id": "frontend-ott-package",
      "repositoryKind": "frontend",
      "pathPrefix": "packages/@ott/",
      "publication": {
        "kind": "human_final",
        "developmentPublishCommand": "pnpm component:publish-dev"
      }
    }
  ]
}
