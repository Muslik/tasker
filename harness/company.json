{
  "schemaVersion": 2,
  "id": "twiket-frontend",
  "version": "4",
  "availableCapabilities": [
    "ci.read",
    "command.run",
    "code-review.write",
    "git.write",
    "repository.read",
    "tracker.write",
    "workspace.write"
  ],
  "processCommands": {},
  "workspaceRuntime": {
    "engine": "docker",
    "image": {
      "kind": "prebuilt",
      "reference": "tasker/workspace:local"
    },
    "workspaceMountPath": "/workspace",
    "environment": {
      "HOME": "/tasker/home",
      "MISE_DATA_DIR": "/tasker/cache/mise/data",
      "MISE_CACHE_DIR": "/tasker/cache/mise/cache",
      "MISE_CONFIG_DIR": "/tasker/home/.config/mise",
      "PNPM_HOME": "/tasker/home/.local/share/pnpm",
      "DOCKER_HOST": "tcp://tasker-docker:2375",
      "PATH": "/tasker/home/.local/share/pnpm:/tasker/home/.local/share/pnpm/bin:/tasker/cache/mise/data/shims:/usr/local/bin:/usr/bin:/bin",
      "PLAYWRIGHT_BROWSERS_PATH": "/tasker/cache/playwright"
    },
    "bootstrap": [],
    "cacheVolumes": [
      { "id": "home", "mountPath": "/tasker/home" },
      { "id": "node-modules", "mountPath": "/workspace/node_modules" },
      { "id": "pnpm-store", "mountPath": "/tasker/cache/pnpm-store" },
      { "id": "mise-cache", "mountPath": "/tasker/cache/mise" },
      { "id": "playwright-browsers", "mountPath": "/tasker/cache/playwright" },
      {
        "id": "nested-docker-data",
        "mountPath": "/var/lib/docker",
        "serviceIds": ["tasker-docker"]
      }
    ],
    "services": [
      {
        "id": "tasker-docker",
        "image": { "kind": "prebuilt", "reference": "docker:29-dind" },
        "command": "dockerd-entrypoint.sh --host=tcp://0.0.0.0:2375 --tls=false",
        "shell": "sh",
        "privileged": true,
        "aliases": ["tasker-docker"],
        "readyCheck": "docker info --format '{{.ServerVersion}}' >/dev/null",
        "environment": { "DOCKER_TLS_CERTDIR": "" }
      }
    ]
  },
  "systemPrompts": {
    "implementationPlanner": "prompts/implementation-planner.md",
    "implementationPlannerSkills": ["jira", "confluence", "loop", "grill-me"],
    "workflowAnalyzer": "prompts/workflow-analyzer.md"
  },
  "retrospective": { "enabled": true },
  "apiPricing": {
    "version": "openai-2026-08-22",
    "sourceUrls": [
      "https://developers.openai.com/api/docs/models/gpt-5.6-sol",
      "https://developers.openai.com/api/docs/models/gpt-5.6-terra",
      "https://developers.openai.com/api/docs/models/gpt-5.6-luna"
    ],
    "models": {
      "gpt-5.6-sol": {
        "inputPerMillionUsd": 4,
        "cachedInputPerMillionUsd": 0.4,
        "outputPerMillionUsd": 20,
        "longContext": {
          "thresholdTokens": 272000,
          "inputMultiplier": 2,
          "outputMultiplier": 1.5
        }
      },
      "gpt-5.6-terra": {
        "inputPerMillionUsd": 2,
        "cachedInputPerMillionUsd": 0.2,
        "outputPerMillionUsd": 12,
        "longContext": {
          "thresholdTokens": 272000,
          "inputMultiplier": 2,
          "outputMultiplier": 1.5
        }
      },
      "gpt-5.6-luna": {
        "inputPerMillionUsd": 0.2,
        "cachedInputPerMillionUsd": 0.02,
        "outputPerMillionUsd": 1.2,
        "longContext": {
          "thresholdTokens": 272000,
          "inputMultiplier": 2,
          "outputMultiplier": 1.5
        }
      }
    }
  },
  "executionProfiles": {
    "workflow-analysis": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-terra",
      "effort": "medium",
      "timeoutMs": 600000,
      "serviceTier": "fast"
    },
    "planning-fast": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-terra",
      "effort": "medium",
      "timeoutMs": 600000,
      "serviceTier": "fast"
    },
    "planning-ralplan": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "timeoutMs": 1800000,
      "serviceTier": "fast"
    },
    "context-simple": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-luna",
      "effort": "medium",
      "timeoutMs": 600000,
      "serviceTier": "fast"
    },
    "implementation-simple": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-luna",
      "effort": "medium",
      "timeoutMs": 1200000,
      "serviceTier": "fast"
    },
    "implementation-standard": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-terra",
      "effort": "high",
      "timeoutMs": 1800000,
      "serviceTier": "fast"
    },
    "verification-complex": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "timeoutMs": 1800000,
      "serviceTier": "fast"
    },
    "investigation": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "timeoutMs": 2100000,
      "serviceTier": "fast"
    },
    "implementation": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "timeoutMs": 2100000,
      "serviceTier": "fast"
    },
    "verification": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-terra",
      "effort": "medium",
      "timeoutMs": 1200000,
      "serviceTier": "fast"
    },
    "documentation": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-terra",
      "effort": "low",
      "timeoutMs": 600000,
      "serviceTier": "fast"
    },
    "review": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "timeoutMs": 1200000,
      "serviceTier": "fast"
    },
    "review-simple": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-terra",
      "effort": "medium",
      "timeoutMs": 600000,
      "serviceTier": "fast"
    },
    "review-standard": {
      "provider": "codex",
      "command": "codex",
      "model": "gpt-5.6-terra",
      "effort": "high",
      "timeoutMs": 900000,
      "serviceTier": "fast"
    },
    "claude-ralplan": {
      "provider": "claude",
      "command": "claude",
      "model": "opus",
      "effort": "high",
      "timeoutMs": 1800000
    }
  },
  "executionProfileRouting": {
    "workflowAnalyzer": "workflow-analysis",
    "implementationPlanner": {
      "fast": "planning-fast",
      "ralplan": "planning-ralplan"
    },
    "taskStrategies": {
      "simple": {
        "context": "context-simple",
        "implementation": "implementation-simple",
        "verification": "verification",
        "review": "review-simple"
      },
      "standard": {
        "context": "workflow-analysis",
        "implementation": "implementation-standard",
        "verification": "verification",
        "review": "review-standard"
      },
      "complex": {
        "context": "investigation",
        "implementation": "implementation",
        "verification": "verification-complex",
        "review": "review"
      }
    }
  }
}
