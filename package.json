{
  "name": "tasker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "protobufjs",
      "better-sqlite3"
    ]
  },
  "scripts": {
    "build": "pnpm build:server && pnpm build:cockpit",
    "build:server": "tsc -p tsconfig.build.json && node scripts/copy-build-assets.mjs",
    "build:cockpit": "vite build",
    "typecheck": "pnpm typecheck:server && pnpm typecheck:cockpit && pnpm typecheck:ui",
    "typecheck:server": "tsc --noEmit",
    "typecheck:cockpit": "tsc --noEmit -p tsconfig.cockpit.json",
    "typecheck:ui": "tsc --noEmit -p tsconfig.ui.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "test:repository": "vitest run --project repository",
    "test:contract": "vitest run --project contract",
    "test:recovery": "vitest run --project recovery",
    "test:operator": "vitest run --project operator",
    "test:e2e": "playwright test",
    "test:integration": "pnpm test:repository && pnpm test:contract",
    "test:coverage": "vitest run --coverage.enabled",
    "depcruise": "dependency-cruiser src --config .dependency-cruiser.cjs --validate",
    "dev": "pnpm build && node scripts/start-local.mjs",
    "dev:api:operator": "pnpm build:server && node dist/server/operator-server.js",
    "dev:cockpit": "vite",
    "dev:ui": "vite --config vite.ui.config.ts",
    "temporal:dev": "temporal server start-dev --namespace tasker-dev --db-filename .tasker/temporal.sqlite",
    "temporal:api": "pnpm dev:api:operator",
    "temporal:worker": "pnpm build:server && node dist/kernel/worker-main.js",
    "harness:setup": "node scripts/setup-harness-imports.mjs",
    "harness:smoke": "pnpm build:server && node scripts/smoke-project-harness.mjs",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm depcruise && pnpm test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@tanstack/react-query": "5.102.8",
    "@temporalio/activity": "1.21.1",
    "@temporalio/client": "1.21.1",
    "@temporalio/worker": "1.21.1",
    "@temporalio/workflow": "1.21.1",
    "better-sqlite3": "13.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fastify": "5.11.0",
    "lucide-react": "1.28.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@temporalio/testing": "1.21.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.8.0",
    "fast-check": "4.9.0",
    "lightningcss": "1.33.0",
    "prettier": "3.9.6",
    "shadcn": "4.16.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
